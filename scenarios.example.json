            "parameters": { "value": false },
            "delay": 500
          }
        ]
      }
    ]
  },
  {
    "id": "movie-mode",
    "name": "Movie Mode",
    "description": "Dim lights to 20% and set warm color temperature",
    "enabled": true,
    "transitionTime": 3,
    "deviceActions": [
      {
        "deviceId": "goodearth_living_room",
        "commands": [
          {
            "command": "brightness",
            "parameters": { "value": 20 }
          },
          {
            "command": "colorTemp",
            "parameters": { "value": 2700 },
            "delay": 1000
          }
        ]
      }
    ]
  },
  {
    "id": "morning-routine",
    "name": "Morning Routine",
    "description": "Turn on heat, set lights to daylight",
    "enabled": true,
    "deviceActions": [
      {
        "deviceId": "gree_192_168_1_100",
        "commands": [
          {
            "command": "power",
